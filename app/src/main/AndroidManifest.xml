<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Reminder delivery must be exact and survive Doze (CLAUDE.md rule 7).
         USE_EXACT_ALARM (API 33+) is auto-granted for a reminders/alarms app, so
         canScheduleExactAlarms() is true without sending the user to settings;
         SCHEDULE_EXACT_ALARM covers API 31–32 only (it is denied-by-default on 33+). -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- targetSdk 35 enforces package visibility: declare the cue pickers we
         launch so they resolve. The system photo picker (ACTION_PICK_IMAGES) is
         always visible; these cover its GET_CONTENT/OPEN_DOCUMENT fallback on
         devices without it, plus the system notification-sound chooser. All local
         — no network. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="image/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <data android:mimeType="image/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.RINGTONE_PICKER" />
        </intent>
    </queries>

    <application
        android:name=".GroundedApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GroundedApp">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The focused in-the-moment screen, opened by tapping a cue-fire notification.
             Private to the app (explicit intent only); not a launcher entry. -->
        <activity
            android:name=".InTheMomentActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.GroundedApp" />

        <!-- Reminder-model cue-fire + response actions. Explicit-component
             intents only (alarms + notification action buttons), so no filter is
             needed; exported=false keeps it private to the app. -->
        <receiver
            android:name=".notifications.ReminderFireReceiver"
            android:exported="false" />

        <!-- Re-arms alarms after a reboot AND after the app is updated: the OS cancels all
             pending alarms on package replace, so without MY_PACKAGE_REPLACED every reminder
             would go silent on the update itself until the next reboot or manual edit. -->
        <receiver
            android:name=".notifications.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
